# AWS / Bedrock (on-demand only — no provisioned throughput)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# S3 — free tier: 5 GB storage, 20k GET, 2k PUT per month
S3_BUCKET_NAME=agentrag-docs-yourname-replace-me

# DynamoDB — on-demand billing, only provisioned if M2 needs structured trace state
DYNAMODB_TABLE_NAME=agentrag-traces

# Budget alarm — agent MUST ask before provisioning anything above this
BUDGET_ALARM_THRESHOLD=2.0

# API security — change to a strong secret before deploying
API_KEY=replace-me-with-a-strong-secret
